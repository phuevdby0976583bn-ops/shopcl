# ==========================================
# CẤU HÌNH CHO AIOGRAM SHOP BOT (RENDER + SUPABASE + UPSTASH)
# ==========================================

# 1. TELEGRAM BOT
# Token lấy từ @BotFather
TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
# ID Telegram của bạn (Lấy từ bot @userinfobot), nếu nhiều ID thì cách nhau bằng dấu phẩy
ADMIN_ID_LIST="123456789"
# Link hỗ trợ khi khách bấm nút Help
SUPPORT_LINK="https://t.me/your_telegram_username"
# Chuỗi bảo mật ngẫu nhiên cho Telegram Webhook (tự đặt một chuỗi bí mật bất kỳ)
WEBHOOK_SECRET_TOKEN="my_secret_token_shopbot_123456"

# 2. RENDER HOẶC DOMAIN MÁY CHỦ
# Khi deploy lên Render, điền link Render của bạn (bỏ dấu gạch chéo ở cuối)
# Ví dụ: https://my-shop-bot.onrender.com
WEBHOOK_HOST="https://my-shop-bot.onrender.com"
WEBHOOK_PATH="/"
WEBAPP_HOST="0.0.0.0"
# Render sẽ tự gán cổng qua biến PORT, nếu chạy local thì dùng 5000
WEBAPP_PORT=5000

# 3. CƠ SỞ DỮ LIỆU POSTGRESQL (SUPABASE HOẶC NEON)
# Lấy từ Supabase: Project Settings -> Database
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_supabase_database_password"
DB_HOST="db.xxxxxxxxxxxx.supabase.co"
DB_PORT=5432
POSTGRES_DB="postgres"

# 4. REDIS (UPSTASH)
# Lấy từ Upstash: Endpoint, Port, Password
REDIS_HOST="xxxx-xxxx-12345.upstash.io"
REDIS_PORT=6379
REDIS_PASSWORD="your_upstash_redis_password"
REDIS_SSL="true"

# 5. WEB ADMIN (SQLADMIN)
# Mật khẩu để bạn đăng nhập vào trang quản trị web: https://link-render-cua-ban/admin
SQLADMIN_RAW_PASSWORD="MatKhauAdminCuaBan123@"
# Khóa JWT bí mật (tự đặt chuỗi ký tự ngẫu nhiên dài dài)
JWT_SECRET_KEY="random_jwt_secret_key_chuoi_ngau_nhien_dai"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="30"

# 6. CẤU HÌNH SHOP & TIỀN TỆ
# Đơn vị tiền tệ hiển thị: USD, EUR, GBP,...
CURRENCY="USD"
PAGE_ENTRIES="8"
MULTIBOT="false"

# 7. CỔNG THANH TOÁN KRYPTO EXPRESS (Nếu chưa dùng có thể để trống)
KRYPTO_EXPRESS_API_KEY=""
KRYPTO_EXPRESS_API_URL="https://kryptoexpress.pro/api"
KRYPTO_EXPRESS_API_SECRET=""
CRYPTO_FORWARDING_MODE="false"

# 8. HỆ THỐNG GIỚI THIỆU (REFERRAL)
MIN_REFERRER_TOTAL_DEPOSIT="500"
REFERRAL_BONUS_PERCENT="5"
REFERRAL_BONUS_DEPOSIT_LIMIT="3"
REFERRER_BONUS_PERCENT="3"
REFERRER_BONUS_DEPOSIT_LIMIT="5"
REFERRAL_BONUS_CAP_PERCENT="7"
REFERRER_BONUS_CAP_PERCENT="7"
TOTAL_BONUS_CAP_PERCENT="12"
